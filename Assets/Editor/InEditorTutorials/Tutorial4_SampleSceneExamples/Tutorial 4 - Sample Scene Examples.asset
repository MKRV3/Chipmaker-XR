  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'The <b>Spatial Panel UI</b> is an example of a <b>Network Grab Interactable.</b> It has a <b>Network Billboard</b> component that will face the panel towards the player currently interacting with the grab handle.


      The Spatial Panel UI also shows different networked UIs (similar to the Music Player UI).'
