  Text:
    m_Untranslated: "The Sample Scene contains numerous UI examples, such as:\n   \xB7 Player Menu UI\n   \xB7 Music Player UI\n   \xB7 Message Board UI\n   \xB7 Spatial Panel UI\n   \xB7 Network Interactable Spawner"
--- !u!114 &-7023033151011791227
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The <b>Message Board UI</b> shows how players can communicate non-verbally using a keyboard to type messages. The <b>Message Board</b> prefab lets you determine the max message history length and max length of messages. It also has a very simple editor tool to test sending messages in editor. \n\n<b>Note:</b> When using the editor tool, players must be connected to a game."
