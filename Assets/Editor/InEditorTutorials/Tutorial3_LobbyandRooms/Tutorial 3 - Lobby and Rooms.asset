--- !u!114 &-1136173485418720408
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The <b>Room Info UI</b> displays the following information:\n   \xB7 <b>Room Name</b>\n   \xB7 <b>Room Code</b> (join code)\n   \xB7 <b>Participant<b> count\n   \xB7 Player List UI prefab\n\n<b>Note:</b>The <b>Player List UI</b> prefab is a high level prefab that you can place on any UI canvas to get info of all connected players, as well as being able to squelch any players along with seeing their local muted states."
